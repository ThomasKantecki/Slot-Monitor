{
  "name": "slot-monitor",
  "version": "1.0.0",
  "description": "Appointment availability and provider footprint, AdventHealth vs Orlando Health in Florida, one specialty at a time.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "directory": "node directories/orlando-health.js",
    "adventhealth": "node directories/capture-adventhealth.mjs",
    "data": "node rosters/build-rosters.mjs",
    "build:provider-map": "node pages/provider-index/render.js",
    "build:slot-data": "node slots/build-slot-times-data.mjs",
    "audit:geography": "node checks/audit-geography-coverage.mjs",
    "audit:opportunities": "node checks/audit-opportunities.mjs",
    "build:slot-times": "node slots/build-slot-times-data.mjs && node slots/build-slot-partitions.mjs && node pages/slot-availability/render.js",
    "build:opportunities": "node slots/build-slot-times-data.mjs && node slots/build-slot-partitions.mjs && node pages/market-opportunities/render.js",
    "build": "node slots/build-specialties.mjs && node pages/shared/specialty-placeholders.js",
    "extract:ah": "node tooling/run-python.mjs extractor/extract_system.py --system ah",
    "extract:oh": "node tooling/run-python.mjs extractor/extract_system.py --system oh",
    "refresh:cardiology": "node tooling/run-python.mjs extractor/refresh.py",
    "refresh:cardiology:dry-run": "node tooling/run-python.mjs extractor/refresh.py --dry-run",
    "refresh:orthopedics": "node tooling/run-python.mjs extractor/refresh.py --specialty orthopedics",
    "refresh:orthopedics:dry-run": "node tooling/run-python.mjs extractor/refresh.py --specialty orthopedics --dry-run",
    "refresh:gastroenterology": "node tooling/run-python.mjs extractor/refresh.py --specialty gastroenterology",
    "refresh:gastroenterology:dry-run": "node tooling/run-python.mjs extractor/refresh.py --specialty gastroenterology --dry-run",
    "probe:catalog": "node tooling/run-python.mjs extractor/catalog_probe.py",
    "all": "node directories/orlando-health.js && node rosters/build-rosters.mjs && node slots/build-specialties.mjs && node pages/shared/specialty-placeholders.js",
    "geometry": "bash tooling/build-geometry.sh",
    "fonts": "node tooling/embed-fonts.mjs",
    "test": "node --test --test-isolation=none test/*.test.js",
    "audit:dataset": "node --max-old-space-size=6144 checks/audit-dataset.mjs",
    "audit:pages": "node checks/audit-pages.cjs",
    "audit:live": "node checks/audit-live.mjs",
    "verify": "npm test && npm run audit:dataset",
    "audit:layout": "node checks/audit-layout.cjs"
  }
}
