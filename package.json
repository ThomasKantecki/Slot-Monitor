{
  "name": "provider-map",
  "version": "1.0.0",
  "description": "Florida provider footprint map comparing AdventHealth and Orlando Health.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "directory": "node src/sources/directory.js",
    "adventhealth": "node scripts/capture-ah-directory.mjs",
    "data": "node scripts/build-data.mjs",
    "build:provider-map": "node src/render.js",
    "build:slot-data": "node scripts/build-slot-times-data.mjs",
    "audit:geography": "node scripts/audit-geography-coverage.mjs",
    "build:slot-times": "node scripts/build-slot-times-data.mjs && node src/slot-times/render.js",
    "build": "node src/render.js && node scripts/build-slot-times-data.mjs && node src/slot-times/render.js",
    "extract:ah": "node scripts/run-python.mjs extractors/cardiology/extract_ah.py",
    "extract:oh": "node scripts/run-python.mjs extractors/cardiology/extract_oh.py",
    "refresh:cardiology": "node scripts/run-python.mjs extractors/cardiology/refresh.py",
    "refresh:cardiology:dry-run": "node scripts/run-python.mjs extractors/cardiology/refresh.py --dry-run",
    "all": "node src/sources/directory.js && node scripts/build-data.mjs && node src/render.js && node scripts/build-slot-times-data.mjs && node src/slot-times/render.js",
    "geometry": "bash scripts/build-geometry.sh",
    "fonts": "node scripts/embed-fonts.mjs",
    "test": "node --test --test-isolation=none"
  }
}
